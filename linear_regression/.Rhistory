#load libraries
library(car)
library(ggplot2)
library(tidyverse)
esg_data <- read.csv("esg_financial_dataset.csv")
poly_esg <- lm(MarketCap~Revenue + EnergyConsumption + Industry + Region + poly(GrowthRate, 3) + poly(ESG_Overall, 3), data=esg_data)
summary(poly_esg)
poly_esg <- lm(MarketCap~Revenue + EnergyConsumption + Industry + Region + poly(GrowthRate, 4) + poly(ESG_Overall, 2), data=esg_data)
summary(poly_esg)
poly_esg <- lm(MarketCap~Revenue + EnergyConsumption + Industry + Region + poly(GrowthRate, 4) + poly(ESG_Overall, 4), data=esg_data)
summary(poly_esg)
