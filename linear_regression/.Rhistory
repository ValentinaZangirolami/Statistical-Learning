library(car)
library(ggplot2)
library(tidyverse)
#load dataset
esg_data <- read.csv("esg_financial_dataset.csv")
ggplot(esg_data, aes(x = GrowthRate, y = MarketCap)) +
geom_point(size = 1, shape=3) +
labs(
x = "GrowthRate",
y = "MarketCap"
) +
theme_minimal()
ggplot(esg_data, aes(x = ESG_Overall, y = MarketCap)) +
geom_point(size = 1, shape=3) +
labs(
x = "GrowthRate",
y = "MarketCap"
) +
theme_minimal()
ggplot(esg_data, aes(x = ProfitMargin, y = MarketCap)) +
geom_point(size = 1, shape=3) +
labs(
x = "GrowthRate",
y = "MarketCap"
) +
theme_minimal()
ggplot(esg_data, aes(x = CarbonEmissions, y = MarketCap)) +
geom_point(size = 1, shape=3) +
labs(
x = "GrowthRate",
y = "MarketCap"
) +
theme_minimal()
ggplot(esg_data, aes(x = ESG_Environmental, y = MarketCap)) +
geom_point(size = 1, shape=3) +
labs(
x = "GrowthRate",
y = "MarketCap"
) +
theme_minimal()
