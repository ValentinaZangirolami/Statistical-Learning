#load data
esg_data <- read.csv("esg_financial_dataset.csv")
#show data
head(esg_data)
View(esg_data)
# we're going to esclude some variables to: (i) alleviate correlation among independent variables, (ii) working just quantitative variables
cat_variables <- esg_data |> select(c(Industry, Region))
esg_data <- esg_data |> select(-c(Industry, Region, ProfitMargin, ESG_Environmental, ESG_Social, ESG_Governance, EnergyConsumption, WaterUsage))
(Scatter_Matrix <- GGally::ggpairs(esg_data,
title = "Scatter Plot Matrix for ESG data",
axisLabels = "show"))
#load data
esg_data <- read.csv("esg_financial_dataset.csv")
#show data
head(esg_data)
# we're going to esclude some variables to: (i) alleviate correlation among independent variables, (ii) working just quantitative variables
cat_variables <- esg_data |> select(c(Industry, Region))
esg_data <- esg_data |> select(-c(Industry, Region, ProfitMargin, ESG_Environmental, ESG_Social, ESG_Governance, EnergyConsumption)) #WaterUsage
(Scatter_Matrix <- GGally::ggpairs(esg_data,
title = "Scatter Plot Matrix for ESG data",
axisLabels = "show"))
mod <- lm(MarketCap~., data=esg_data)
summary(mod)
################################################################################
#                                                                              #
#                     Multiple linear regression models                        #
#                                                                              #
################################################################################
#                           Valentina Zangirolami                              #
################################################################################
#load libraries
library(car)
library(ggplot2)
library(tidyverse)
#load data
esg_data <- read.csv("esg_financial_dataset.csv")
#show data
head(esg_data)
# we're going to esclude some variables to: (i) alleviate correlation among independent variables, (ii) working just quantitative variables
cat_variables <- esg_data |> select(c(Industry, Region))
esg_data <- esg_data |> select(-c(Industry, Region, ProfitMargin, ESG_Environmental, ESG_Social, ESG_Governance, EnergyConsumption, WaterUsage))
#marginal interpretation
(Scatter_Matrix <- GGally::ggpairs(esg_data,
title = "Scatter Plot Matrix for ESG data",
axisLabels = "show"))
#linear regression
mod <- lm(MarketCap~., data=esg_data)
summary(mod)
round(mod$coefficients, 5)
#diagnostic plot
par(mfrow=c(2,2))
plot(mod) # some issues
esg_data <- cbind(esg_data, cat_variables)
mod_2 =lm(MarketCap~., data=esg_data)
summary(mod_2)
unique(esg_data$Industry) # 8 dummies out of 9 categories
unique(esg_data$Region) # 6 dummies out of 7 categories
anova(mod, mod_2)
par(mfrow=c(2,2))
plot(mod_2)
ggplot(esg_data, aes(x = CarbonEmissions, y = MarketCap, color = Region)) +
geom_point(size = 1, shape=3) +
geom_smooth(method = "lm", se = FALSE) +  # Adds linear regression lines
labs(
title = "Scatter Plot with Interaction Effect & Regression Lines",
x = "ESG Overall",
y = "MarketCap",
color = "Region"
) + ylim(0, 50000) +
theme_minimal()
ggplot(esg_data, aes(x = EnergyConsumption, y = MarketCap, color = Industry)) +
geom_point(size = 1, shape=3) +
geom_smooth(method = "lm", se = FALSE) +  # Adds linear regression lines
labs(
title = "Scatter Plot with Interaction Effect & Regression Lines",
x = "ESG Overall",
y = "MarketCap",
color = "Industry"
) + ylim(0, 50000) +
theme_minimal()
ggplot(esg_data, aes(x = CarbonEmission, y = MarketCap, color = Industry)) +
geom_point(size = 1, shape=3) +
geom_smooth(method = "lm", se = FALSE) +  # Adds linear regression lines
labs(
title = "Scatter Plot with Interaction Effect & Regression Lines",
x = "ESG Overall",
y = "MarketCap",
color = "Industry"
) + ylim(0, 50000) +
theme_minimal()
ggplot(esg_data, aes(x = CarbonEmissions, y = MarketCap, color = Industry)) +
geom_point(size = 1, shape=3) +
geom_smooth(method = "lm", se = FALSE) +  # Adds linear regression lines
labs(
title = "Scatter Plot with Interaction Effect & Regression Lines",
x = "ESG Overall",
y = "MarketCap",
color = "Industry"
) + ylim(0, 50000) +
theme_minimal()
View(esg_data)
ggplot(esg_data, aes(x = CarbonEmissions, y = MarketCap, color = Industry)) +
geom_point(size = 1, shape=3) +
geom_smooth(method = "lm", se = FALSE) +  # Adds linear regression lines
labs(
title = "Scatter Plot with Interaction Effect & Regression Lines",
x = "ESG Overall",
y = "MarketCap",
color = "Industry"
) + ylim(0, 50000) +
theme_minimal() +
scale_y_continuous(labels = scales::comma)
ggplot(esg_data, aes(x = CarbonEmissions, y = MarketCap, color = Region)) +
geom_point(size = 1, shape=3) +
geom_smooth(method = "lm", se = FALSE) +  # Adds linear regression lines
labs(
title = "Scatter Plot with Interaction Effect & Regression Lines",
x = "ESG Overall",
y = "MarketCap",
color = "Region"
) + ylim(0, 50000) +
theme_minimal()+
scale_y_continuous(labels = scales::comma)
View(esg_data)
